# Environment Configuration Example
# Copy this file to `.env` and fill in your values.
# 将此文件复制为 `.env` 并填入你的配置。

# ─── Auth Configuration ────────────────────────────────────────────────────

# OAuth Client ID (default is the official OpenAI app client ID, no change needed)
# OAuth 客户端 ID（默认已内置官方 OpenAI 客户端 ID，一般无需修改）
# GATEWAY_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# OAuth Authorization Root (default: https://auth.openai.com)
# GATEWAY_AUTH_ROOT=https://auth.openai.com

# ─── Data Storage ──────────────────────────────────────────────────────────

# Directory for persistent data (accounts, sessions, logs)
# 数据持久化目录（账号池、会话缓存、日志）
# PROXY_DATA_DIR=./data

# ─── Server ────────────────────────────────────────────────────────────────

# Bind host and port for uvicorn
# HOST=0.0.0.0
# PORT=8000
